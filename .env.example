# ============================================================
# OpsPilot 部署环境变量（docker compose 用）
#
# 使用：复制成 .env 后修改
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
#
# ⚠️ .env 已经在 .gitignore 里，不会进版本库。
#    但里面的 Key 和密码仍然要保管好 —— 别截图、别发群里。
#
# 如果不创建这个文件，compose 会用文件里写的默认值（适合本地快速体验）。
# ============================================================

# ── 数据库 ─────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=opspilot
MYSQL_USER=opspilot
MYSQL_PASSWORD=opspilot123

# ── 应用 ───────────────────────────────────────────────────
APP_ENV=dev
DEBUG=false
# JWT 签名密钥。生产环境必须换掉！
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-secret-change-me-in-production

# ── 大模型（OpenAI 兼容接口）────────────────────────────────
# ★ 把 LLM_API_KEY 换成你自己的，否则 Agent 功能不可用
# 申请地址（阿里云百炼）：https://bailian.console.aliyun.com/
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-在这里填你的Key
LLM_MODEL=qwen-plus
