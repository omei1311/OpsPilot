# ============================================================
# Docker 构建时忽略的文件
# ============================================================

# ★ 依赖目录必须排除。
# 镜像里会重新 npm ci 装（保证和 lock 文件一致）；
# 而且从 Windows 拷过去的 node_modules 里有平台相关的二进制包，
# 在 Linux 容器里直接用会报错。
node_modules/

# 上一次的构建产物
dist/
dist-ssr/

# 本地环境变量
.env
.env.*
!.env.example

# 编辑器与版本控制
.git/
.gitignore
.idea/
.vscode/

# 本地日志
*.log
npm-debug.log*
fe.out.log
fe.err.log
