# ============================================================
# OpsPilot 后端环境变量
# 使用方式：复制为 .env 后按需修改
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
# ============================================================

# ── 应用 ────────────────────────────────────────────────────
APP_NAME=OpsPilot
APP_VERSION=0.1.0
# dev / test / prod
APP_ENV=dev
DEBUG=true
# 统一 API 前缀，改动会同步影响所有路由与前端 baseURL
API_V1_PREFIX=/api/v1

# ── 服务监听 ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ───────────────────────────────────────────────────
# 多个来源用【英文逗号】分隔，不要加空格，不要用引号包裹整体
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ── MySQL ──────────────────────────────────────────────────
# 这组值对应 docker-compose.dev.yml 暴露到宿主机的端口（3307，避开本机可能已装的 MySQL）。
# 将来后端也进容器时，HOST 改成服务名 mysql、PORT 改回 3306。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=opspilot
MYSQL_PASSWORD=opspilot123
MYSQL_DATABASE=opspilot
# asyncmy（默认，需编译环境）/ aiomysql（纯 Python，Windows 兜底）
DB_DRIVER=asyncmy

# 直接指定完整连接串时，上面的 MYSQL_* 会被忽略。
# 例如指向已有实例：DATABASE_URL=mysql+asyncmy://user:pass@host:3306/db?charset=utf8mb4
# DATABASE_URL=

# ── 连接池 ─────────────────────────────────────────────────
# 打印所有 SQL，排查问题时开，平时关（日志量很大）
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 小于 MySQL 的 wait_timeout，避免用到已被服务端关闭的连接（默认 3600s）
DB_POOL_RECYCLE=3600
# 取连接前先 ping 一下，防止 "MySQL server has gone away"
DB_POOL_PRE_PING=true

# ── 日志 ───────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── 大模型（OpenAI 兼容接口）────────────────────────────────
#
# ★ 把下面三行的值换成你自己的。改完重启后端生效。
# ★ .env 已经在 .gitignore 里，不会被提交 —— 千万不要把 Key 写进代码。
#
# 只要服务商提供 OpenAI 兼容接口，改这两项就能切换：
#   LLM_BASE_URL  = 接口地址（注意一般要以 /v1 结尾）
#   LLM_MODEL     = 模型名
#
# 常用服务商配置（选一个，注释掉其他的）：
#
#   【阿里云百炼 / 通义千问】
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#
#   【DeepSeek】
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
#   【智谱 GLM】
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-plus
#
#   【月之暗面 Kimi】
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL=moonshot-v1-8k
#
#   【本地 Ollama】（无需 Key，适合完全离线演示）
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
#   LLM_API_KEY=ollama

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-在这里填你的Key
LLM_MODEL=qwen-plus

# 单次请求超时（秒）。Agent 要多次调用模型，别设太短
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# 采样温度：0 最稳定（适合工具调用），1 最发散。
# Agent 场景建议 0~0.3，否则模型容易乱调工具
LLM_TEMPERATURE=0.1

# ── Agent 行为 ─────────────────────────────────────────────
# 最大工具调用轮数，防止模型陷入死循环把 token 烧光
AGENT_MAX_STEPS=12
# 单次运行最多消耗多少 token，超过强制中断
AGENT_MAX_TOKENS_PER_RUN=50000
# 单次运行的超时时间（秒）
AGENT_RUN_TIMEOUT=120
# 批量操作单次最多影响多少条（安全阀）
AGENT_BATCH_LIMIT=100
# 待确认操作的超时时间（秒），超时自动作废
AGENT_APPROVAL_TIMEOUT=600
